<div class="section" id="facerecognition">

{{#if clustersByName}}
	{{> clustersByNamePart
			clustersByName=clustersByName
			personName=personName
			renameHint=renameHint
			hideHint=hideHint
	}}
{{else if personName}}
	{{> singlePersonPart 
			personName=personName 
			renameHint=renameHint
			hideHint=hideHint
			hasHidden=hasHidden 
			hasUnamed=hasUnamed 
			reviewIgnoredMsg=reviewIgnoredMsg
			reviewPeopleMsg=reviewPeopleMsg
			showMoreButton=showMoreButton
			personImages=personImages
	}}
{{else if persons}}
	{{> peoplePart 
			appName=appName
			enabled=enabled 
			enableDescription=enableDescription
			hasHidden=hasHidden 
			hasUnamed=hasUnamed 
			reviewIgnoredMsg=reviewIgnoredMsg
			reviewPeopleMsg=reviewPeopleMsg
			persons=persons 
			noPhotos=noPhotos
			count=count
	}}
{{else if loaded}}
	{{> loadedPart
			appName=appName
			enabled=enabled 
			enableDescription=enableDescription
			hasHidden=hasHidden 
			hasUnamed=hasUnamed 
			reviewIgnoredMsg=reviewIgnoredMsg
			reviewPeopleMsg=reviewPeopleMsg
			emptyMsg=emptyMsg
			emptyHint=emptyHint
	}}
{{else}}
	{{> loadingPart }}
{{/if}}

</div>